# media-lab local configuration.
# Copy to .env and adjust. This project is fully local and uses NO API keys.

# Directory holding the static ffmpeg/ffprobe binaries.
MEDIA_LAB_FFMPEG_DIR=./bin

# Source media. Files here are READ ONLY and never modified.
MEDIA_LAB_IN_DIR=./in

# Rendered output.
MEDIA_LAB_OUT_DIR=./out

# Intermediate files kept for inspection between pipeline stages.
MEDIA_LAB_WORK_DIR=./work

# Hard timeout for a single kino CLI invocation, in seconds.
MEDIA_LAB_KINO_TIMEOUT_S=1800

# Hyperframes CLI used by kinocut for person cutouts.
MCP_VIDEO_HYPERFRAMES_COMMAND=./node_modules/.bin/hyperframes

# RVM (Robust Video Matting) source checkout, for the `matte` command.
# Cloned by ./scripts/fetch-rvm.sh. Not validated at startup - only `matte` needs it.
MEDIA_LAB_RVM_REPO=./tools/RobustVideoMatting

# Directory holding the RVM (.pth) weight files.
MEDIA_LAB_WEIGHTS_DIR=./work/punto-edit/gen/weights
